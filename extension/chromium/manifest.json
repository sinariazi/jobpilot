{
  "manifest_version": 3,
  "name": "Jobpilot Local Form Helper",
  "version": "1.0.0",
  "description": "Fill recognized empty ATS fields from your local Jobpilot profile after you click the extension button.",
  "key": "",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Jobpilot Local Form Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://grnh.se/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*"
      ],
      "js": ["prefill.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
