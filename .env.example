# Optional. Ollama uses this loopback address by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional preferred model name; Jobpilot discovers installed models and lets you choose one.
OLLAMA_MODEL=
# Optional default for the local /v1/systemone decision screening stage. Choose an installed decision model in Jobpilot.
OLLAMA_DECISION_MODEL=
# Optional Adzuna job search. Create an API account and use its credentials only
# after reviewing Adzuna's terms for your own use. Never commit real credentials.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
